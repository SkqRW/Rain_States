{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "palette.schema.json",
  "title": "Rain States Palette Map",
  "description": "Map of region or room keys to palette/time sequences for Rain States.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["palette", "time"],
    "properties": {
      "palette": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "integer", "description": "Palette ID as integer (e.g., 1000, 20)" }
      },
      "time": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "description": "Times in (0,1], strictly increasing; last value typically 1.0; length must match 'palette'"
      }
    },
    "additionalProperties": false
  },
  "examples": [
    {
      "UW": {
        "palette": [1000, 20, 1002],
        "time": [0.2, 0.6, 1.0]
      },
      "UW_A01": {
        "palette": [1001, 1002],
        "time": [1.0, 1.0]
      }
    }
  ]
}
